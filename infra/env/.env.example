# NutriScan AI — environment variables
# Copy to .env and fill in real values. Never commit .env.

# Gateway URL used by mobile app
# Local dev: http://localhost:8000
# Android emulator: http://10.0.2.2:8000
# Real device (LAN): http://192.168.x.x:8000
NUTRISCAN_API_BASE_URL=http://localhost:8000

# Optional: enables Claude-powered summaries in ai-nutrition service
ANTHROPIC_API_KEY=
