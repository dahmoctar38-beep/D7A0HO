# Netlify deployment environment variables (set in Netlify UI, not in repo)

# Optional: forward interest submissions to your sink (webhook/CRM/API).
# If empty, /api/interest accepts payloads but does not persist externally.
INTEREST_FORWARD_URL=

# Optional: forward analytics events to your sink (PostHog ingest proxy/custom API).
# If empty, /api/events accepts payloads but does not persist externally.
ANALYTICS_FORWARD_URL=

# Optional operational metadata for your own tracking
LANDING_ENV=production
